# Normalize line endings: LF in the repository, auto-detect on checkout
* text=auto eol=lf

# Source and docs as text
*.php      text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.html     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
.htaccess  text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
